{
  "name": "sidestage-copilot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "SideStage \u2014 a real-time AI copilot for solo live-commerce sellers. Grounded replies, enforced guardrails, reversible listing and inventory actions.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "seed": "tsx src/db/seed.ts",
    "seed:agent": "tsx src/llm/seedAgent.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "eval": "node --import tsx --test test/*.eval.ts",
    "bench": "tsx bench/latency.bench.ts",
    "demo:stale-price": "tsx bench/stalePrice.demo.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "better-sqlite3": "^11.5.0",
    "fastify": "^5.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
