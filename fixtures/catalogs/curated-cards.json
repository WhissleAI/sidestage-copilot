{
  "id": "curated-cards",
  "name": "MLB Singles & Graded Slabs",
  "seller": {
    "handle": "@curatedcards",
    "name": "Curated Cards and Collectibles",
    "about": "Sports card singles and graded slabs. 99.9% positive over 76k feedback. Ships from the United States, member since 2021.",
    "voice": "Warm and fast. Collectors know their stuff — be specific about the year, set and grade, never vague."
  },
  "policies": [
    {
      "id": "pol_ship_domestic",
      "topic": "shipping",
      "title": "Domestic shipping",
      "body": "US orders ship USPS Ground Advantage at a flat $9.95, free on orders over $250. Handling time is one business day; orders placed during a weekend show go out Monday."
    },
    {
      "id": "pol_ship_intl",
      "topic": "shipping",
      "title": "International shipping",
      "body": "We ship to Canada and the UK via eBay International Shipping. Import duties and taxes are the buyer's responsibility. We do not ship raw cards outside North America."
    },
    {
      "id": "pol_returns",
      "topic": "returns",
      "title": "Returns",
      "body": "30-day returns on graded slabs in the original holder. Raw singles are sold as described and are returnable only if they arrive not as described, in which case we cover return shipping."
    },
    {
      "id": "pol_auth",
      "topic": "authenticity",
      "title": "Grading and authenticity",
      "body": "Graded cards ship in their original PSA or BGS holder with the cert number on the label, verifiable on the grader's site. Raw cards are ungraded and described honestly on air; we do not guarantee a future grade."
    },
    {
      "id": "pol_discount",
      "topic": "discount",
      "title": "Discounts on air",
      "body": "Live-show discounts cap at 15% off the listed price and never go below the item's floor price. Bundle two or more cards from the same show for an extra 5%."
    },
    {
      "id": "pol_tone",
      "topic": "tone",
      "title": "Voice and tone",
      "body": "Warm, fast, specific. One or two sentences. Name the year, set and grade. Never hype a card beyond what the condition notes support."
    },
    {
      "id": "pol_prohibited",
      "topic": "prohibited",
      "title": "Claims we never make",
      "body": "Never describe a card as an investment or promise it will appreciate. Never predict a grade for a raw card. Never say 'guaranteed authentic' for an ungraded card. Never promise a delivery date we do not control."
    }
  ],
