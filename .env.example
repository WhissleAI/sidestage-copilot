# ── Whissle gateway (the only LLM provider; see docs/TDD.md §2) ───────────────
# Workspace SECRET key. Needs agent:read, agent:chat and kb:write scopes.
WHISSLE_API_KEY=wsk_live_xxx
# The agent that carries the seller persona + catalog KB. `npm run seed:agent`
# creates one and prints its id.
WHISSLE_AGENT_ID=00000000-0000-0000-0000-000000000000
# Gateway base. The /bot prefix is REQUIRED — it is the gateway's route prefix.
WHISSLE_BASE=https://aws-gateway-backend.whissle.ai/bot

# ── Server ───────────────────────────────────────────────────────────────────
PORT=8790
DB_PATH=./data/sidestage.db
# Bounded reply fan-out. Keep below the gateway's shared LLM semaphore (8).
REPLY_CONCURRENCY=3
# Token bucket on how many buyer questions per minute become proposals.
PROPOSALS_PER_MIN=30
# Latency budget in ms (admit -> rendered). Breaches are logged + surfaced.
LATENCY_BUDGET_MS=2000

# ── Autonomy ladder (docs/PRD.md §5) ─────────────────────────────────────────
# L0_OBSERVE | L1_SUGGEST | L2_ONE_TAP | L3_AUTO_REPLY | L4_AUTO_ACT
AUTONOMY_LEVEL=L1_SUGGEST
# Seconds an executed action stays one-keystroke undoable.
UNDO_WINDOW_S=90
