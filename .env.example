# ── Whissle gateway (the only LLM provider; see docs/TDD.md §2) ───────────────
# Workspace SECRET key. Needs agent:read, agent:chat and kb:write scopes.
WHISSLE_API_KEY=wsk_live_xxx
# The agent that carries the seller persona + catalog KB. `npm run seed:agent`
# creates one and prints its id.
WHISSLE_AGENT_ID=00000000-0000-0000-0000-000000000000
# Gateway base. The /bot prefix is REQUIRED — it is the gateway's route prefix.
WHISSLE_BASE=https://aws-gateway-backend.whissle.ai/bot

# ── Server ───────────────────────────────────────────────────────────────────
PORT=8790
DATABASE_URL=postgres://localhost/sidestage
# Bounded reply fan-out. Keep below the gateway's shared LLM semaphore (8).
REPLY_CONCURRENCY=3
# Token bucket on how many buyer questions per minute become proposals.
PROPOSALS_PER_MIN=30
# Latency budget in ms (admit -> rendered). Breaches are logged + surfaced.
LATENCY_BUDGET_MS=2000

# ── Autonomy ladder (docs/PRD.md §5) ─────────────────────────────────────────
# L0_OBSERVE | L1_SUGGEST | L2_ONE_TAP | L3_AUTO_REPLY | L4_AUTO_ACT
AUTONOMY_LEVEL=L1_SUGGEST
# Seconds an executed action stays one-keystroke undoable.
UNDO_WINDOW_S=90

# ── eBay developer application ───────────────────────────────────────────────
#
# Two capabilities, and they need different things.
#
# READING (search, categories, the aspects eBay requires per category) needs
# only these three. Create an application at developer.ebay.com and paste the
# App ID (Client ID), Cert ID (Client Secret) and Dev ID. `sandbox` and
# `production` are different hosts AND different credentials — a sandbox key
# against the production host is a 401 that does not say so.
EBAY_ENV=sandbox
EBAY_APP_ID=
EBAY_CERT_ID=
EBAY_DEV_ID=
EBAY_MARKETPLACE_ID=EBAY_US
#
# WRITING (price, stock, ending a listing, and importing a catalog from the
# seller's own inventory) additionally needs the seller to sign in and consent.
# eBay redirects them back to a value registered on the application, which it
# calls an RuName. Register `<your host>/api/ebay/callback` as the redirect URL
# in the developer portal and paste the RuName it gives you here. Without it
# `POST /api/ebay/connect` refuses and says so.
EBAY_RUNAME=
#
# NOT available with an ordinary application: SOLD prices. Marketplace Insights
# is limited-release and answers 403 until eBay approves the app for it, so
# comparables are ACTIVE asking prices and every surface says so.
# eBay Marketplace Account Deletion notifications (required before eBay enables a
# production keyset). The token is yours: 32–80 characters, the same value entered
# in the developer portal. The endpoint must match the registered URL exactly.
EBAY_DELETION_VERIFICATION_TOKEN=
EBAY_DELETION_ENDPOINT=

# Optional. Routes ONLY the eBay Live discovery browser through a residential /
# ISP proxy or a SOCKS tunnel (http://user:pass@host:port, socks5://host:port).
# eBay refuses the live grid to a signed-in session on a datacenter address.
EBAY_DISCOVERY_PROXY=

# How often the hosted server re-reads the eBay Live grid (minutes). Keeps the
# Discover tab current and the house session alive. Default 5.
DISCOVERY_REFRESH_MIN=5

# 32 random bytes as 64 hex chars (`openssl rand -hex 32`). Seals seller eBay tokens at rest.
EBAY_TOKEN_KEY=

# ── Reddit (monitor and draft; posting is off in code) ───────────────────────
#
# A "script" app from reddit.com/prefs/apps, created by the account that will
# be watching. Reddit's script grant is a password grant, so the app identity
# (id, secret) and the account identity (username, password) are two halves of
# one credential and four of the five authenticates nobody. The account cannot
# have 2FA on — the password grant has no way to carry a code.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
#
# Not politeness. Reddit rate-limits and blocks on this string, wants it to
# identify the app and its owner, and answers a default Node agent with 429s
# that look exactly like pacing we got wrong. Format:
#   <platform>:<app id>:<version> (by /u/<your reddit username>)
REDDIT_USER_AGENT=
#
# Seconds between polls of a watched subreddit, profile or thread (ms). Reddit's
# own guidance is one request a second sustained; a minute sits far inside it
# and still reads as prompt on a surface where people answer in hours.
REDDIT_POLL_MS=60000
# ── Whatnot and TikTok Live ───────────────────────────────────────────────────
# Neither needs a key: both are read from their public page with real Chrome,
# through the same EBAY_DISCOVERY_PROXY above (Whatnot answers a datacenter
# address with a Cloudflare challenge rather than a room).
#
# TikTok Live is OFF unless this is set to 1/true/yes/on. TikTok can drop any
# session into a verification challenge at any moment, and the browser on the
# other side of it is a real seller's account — so running this one is a person
# saying "I am here", not a default. attach() refuses while it is unset and
# names this variable.
TIKTOK_LIVE_ENABLED=

# ── Resource ceilings ────────────────────────────────────────────────────────
#
# Three numbers, because they bound three different things and conflating them
# is how a box gets OOM-killed instead of refusing an attach.
#
# Watched SESSIONS. Six is a sensible number of sessions.
MAX_WATCHED_SHOWS=6
# Watched rooms on a surface that drives a WHOLE BROWSER of its own — Whatnot
# and TikTok Live. eBay Live shares one Chromium across every show it watches,
# so it does not count here. Six Whatnot rooms is six real Chromes at 150–300MB
# each against a 1100MB container that also holds Node: an OOM kill that takes
# every other show with it.
MAX_SCRAPED_ROOMS=2
# The hard ceiling on Chrome processes across every purpose — room watchers,
# the shared eBay Live browser, the five-minute discovery poll, Whatnot browse.
# Over this the box REFUSES to open another rather than being killed holding
# the ones it has.
MAX_BROWSERS=6

# ── Kill switches and operational levers ─────────────────────────────────────
#
# These are the variables somebody reaches for at 2am, and they were the ones
# this file did not mention.
#
# Whatnot discovery drives a browser on a REQUEST path. After an outage caused
# by browsers, anything of that shape should be switchable off by whoever is
# awake. Set to 0/false/no/off to disable.
WHATNOT_DISCOVERY=
# The scripted demo show. Off unless asked for: it is indistinguishable from a
# working show, which is misleading as the first thing a seller finds.
DEMO_SHOW=
# Re-attach eBay Live shows named here at boot (comma-separated event ids).
WATCH_EBAY=
# The simulated chat driver, and its inter-message delay. Off when a real
# source is attached.
SIMULATE=true
SIMULATE_MIN_MS=1400
SIMULATE_MAX_MS=3600

# ── Paths ────────────────────────────────────────────────────────────────────
# Seller catalogs the operator picks from; written BY THE APP when a show is
# prepared, so anything that syncs over this directory must exclude it.
CATALOGS_DIR=./fixtures/catalogs
# Kept audio, frames and transcripts, per show.
SHOW_MEDIA_DIR=./data/shows
# The signed-in eBay Live browser profile, and the exported session a server
# uses when a Chrome profile cannot travel.
EBAY_PROFILE_DIR=./data/ebay-profile
EBAY_SESSION_PATH=./data/ebay-session.json
# Guardrail policy overrides, as JSON.
GUARDRAIL_POLICY_PATH=

# ── Rates and fault injection ────────────────────────────────────────────────
# Cap on marketplace WRITES per minute.
ACTION_RATE_PER_MIN=
# The mock marketplace's failure rate and added latency, so rollback is
# genuinely exercised rather than asserted.
MARKETPLACE_FAIL_RATE=0
MARKETPLACE_LATENCY_MS=120

# ── The test database ────────────────────────────────────────────────────────
# The suite gets its OWN database: reading DATABASE_URL there wrote test chat
# and proposals into whatever the dev server was serving.
TEST_DATABASE_URL=postgres://localhost:5432/sidestage_test

# ── Compose-level (read by docker-compose.yml, not by the app) ───────────────
# The public hostname Caddy serves and requests a certificate for.
SITE_ADDRESS=
# Postgres' password. Defaults to the literal `sidestage` if unset, which is
# what production is running on: the database publishes no ports and the
# security group opens only 22/80/443, so this is defence in depth rather than
# an exposure — set it anyway.
POSTGRES_PASSWORD=
